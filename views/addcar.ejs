<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Add Car</title>
</head>
<body>
	<h1>Add Car</h1>

	<form action="/host/car-book" method="POST">
		<div>
			<label for="car-name">Car Name</label>
			<input type="text" id="car-name" name="carName" required>
		</div>

		<div>
			<label for="car-no">Car No</label>
			<input type="text" id="car-no" name="carNo" required>
		</div>

		<button type="submit">Submit</button>
	</form>
</body>
</html>
