<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/output.css">
	<title>Car Rental Home</title>
	<style>
		@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Syne:wght@700;800&display=swap');

		:root {
			color-scheme: light;
			--ink: #0f172a;
			--muted: #64748b;
			--line: #e2e8f0;
			--card: #ffffff;
			--wash: #f8fafc;
			--accent: #2563eb;
			--accent-deep: #1d4ed8;
			--accent-soft: #dbeafe;
		}

		body {
			font-family: 'DM Sans', sans-serif;
			background: #eef1f8;
		}

		h1, h2 { font-family: 'Syne', sans-serif; }

		.page-shell {
			max-width: 1200px;
			margin: 0 auto;
			padding: 2.5rem 1rem 3.5rem;
		}

		.page-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}

		.page-title {
			font-size: 2rem;
			font-weight: 800;
			color: var(--ink);
		}

		.page-subtitle {
			color: var(--muted);
			font-size: 0.95rem;
			margin-top: 0.25rem;
		}

		.back-link {
			color: var(--muted);
			font-size: 0.85rem;
			text-decoration: none;
			display: inline-block;
			margin-top: 0.4rem;
		}

		.back-link:hover { text-decoration: underline; }

		.fav-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(220px, 260px));
			gap: 1.4rem;
		}

		/* ── Card ── */
		.fav-card {
			background: var(--card);
			border-radius: 1.4rem;
			overflow: hidden;
			box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
			display: flex;
			flex-direction: column;
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.fav-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 32px rgba(15, 23, 42, 0.13);
		}

		/* ── Media area: warm cream like screenshot ── */
		.fav-media {
			background: #fdf6ec;
			height: 170px;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 1.2rem;
		}

		.fav-media img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		.car-card-placeholder {
			width: 100%;
			height: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		/* ── Body ── */
		.fav-body {
			padding: 1.1rem 1.2rem 1.3rem;
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
		}

		.car-badge {
			display: inline-block;
			background: #eff6ff;
			color: var(--accent);
			font-size: 0.65rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			padding: 3px 10px;
			border-radius: 999px;
			width: fit-content;
			margin-bottom: 0.25rem;
		}

		.car-name {
			font-family: 'Syne', sans-serif;
			font-size: 1.15rem;
			font-weight: 800;
			color: var(--ink);
			line-height: 1.25;
		}

		.car-meta {
			color: var(--muted);
			font-size: 0.82rem;
			font-weight: 500;
			line-height: 1.8;
			margin-bottom: 0.1rem;
		}

		.details-link {
			color: var(--muted);
			font-size: 0.82rem;
			font-weight: 500;
			text-decoration: none;
			margin-bottom: 0.5rem;
		}

		.details-link:hover { text-decoration: underline; }

		/* ── Book button ── */
		.book-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			background: var(--accent);
			color: #fff;
			border: none;
			border-radius: 0.75rem;
			padding: 0.65rem 1rem;
			font-size: 0.9rem;
			font-weight: 700;
			cursor: pointer;
			text-decoration: none;
			margin-top: 0.4rem;
			transition: background 0.18s ease;
		}

		.book-btn:hover { background: var(--accent-deep); }

		/* ── Empty state ── */
		.empty-state {
			border: 2px dashed #cbd5e1;
			border-radius: 1.4rem;
			padding: 2.5rem;
			text-align: center;
			color: #94a3b8;
			font-size: 0.95rem;
			background: rgba(255, 255, 255, 0.7);
		}
	</style>
</head>
<body class="min-h-screen text-slate-800">
	<%- include('../partials/navbar') %>
	<main class="page-shell">
		<section class="page-header">
			<div>
				<h2 class="page-title">Favourites</h2>
				<p class="page-subtitle">Your saved cars, ready to book.</p>
				<a href="/" class="back-link">&larr; Back to cars</a>
			</div>
			<% if (favourites.length > 0) { %>
				<span class="text-sm text-slate-500"><%= favourites.length %> car<%= favourites.length > 1 ? 's' : '' %></span>
			<% } %>
		</section>

		<div class="fav-grid">
			<% if (favourites.length === 0) { %>
				<div class="empty-state">No cars added yet.</div>
			<% } else { %>
				<% favourites.forEach((car) => { %>
					<article class="fav-card">

						<!-- Image / placeholder -->
						<div class="fav-media">
							<% if (car.photoUrl) { %>
								<img src="<%= car.photoUrl %>" alt="<%= car.name %>" />
							<% } else { %>
								<div class="car-card-placeholder">
									<!-- Flat car SVG matching screenshot style -->
									<svg viewBox="0 0 160 90" width="140" fill="none" xmlns="http://www.w3.org/2000/svg">
										<rect x="10" y="38" width="140" height="32" rx="8" fill="url(#carGrad)"/>
										<rect x="34" y="22" width="80" height="24" rx="6" fill="#1e293b"/>
										<rect x="38" y="26" width="34" height="16" rx="3" fill="#334155"/>
										<rect x="78" y="26" width="32" height="16" rx="3" fill="#334155"/>
										<circle cx="38" cy="72" r="12" fill="#1e293b"/>
										<circle cx="38" cy="72" r="6" fill="#fbbf24"/>
										<circle cx="118" cy="72" r="12" fill="#1e293b"/>
										<circle cx="118" cy="72" r="6" fill="#fbbf24"/>
										<defs>
											<linearGradient id="carGrad" x1="10" y1="38" x2="150" y2="70" gradientUnits="userSpaceOnUse">
												<stop stop-color="#c2410c"/>
												<stop offset="1" stop-color="#ea580c"/>
											</linearGradient>
										</defs>
									</svg>
								</div>
							<% } %>
						</div>

						<!-- Card body -->
						<div class="fav-body">
							<span class="car-badge">Car</span>
							<div class="car-name"><%= car.name %></div>
							<div class="car-meta">
								<%= car.carNo %><br>
								<%= car.carRate %>/hr
							</div>
							<a href="/car/<%= car._id %>" class="details-link">details</a>
							<a href="/book/<%= car._id %>" class="book-btn">Book</a>
							<form action="/delete/<%= car._id %>" method="POST" class="mt-4">
									<button type="submit" class="inline-flex w-full items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">delete</button>
								</form>
						</div>

					</article>
				<% }) %>
			<% } %>
		</div>
	</main>
</body>
</html>
