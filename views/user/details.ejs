<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/output.css">
	<title>Car Details</title>
	<style>
		@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Syne:wght@700;800&display=swap');

		body { font-family: 'DM Sans', sans-serif; }
		h1, h2 { font-family: 'Syne', sans-serif; }

		.car-card {
			position: relative;
			background: #fff;
			border-radius: 1.5rem;
			overflow: hidden;
			box-shadow: 0 8px 28px rgba(0,0,0,0.12);
		}

		.car-card img {
			width: 100%;
			height: 260px;
			object-fit: cover;
			display: block;
		}

		.car-card-placeholder {
			width: 100%;
			height: 260px;
			background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.car-card-body {
			padding: 1.5rem 1.6rem 1.75rem;
		}

		.car-badge {
			display: inline-block;
			background: #eff6ff;
			color: #2563eb;
			font-size: 0.72rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
			padding: 4px 12px;
			border-radius: 99px;
			margin-bottom: 0.75rem;
		}

		.car-name {
			font-family: 'Syne', sans-serif;
			font-size: 1.5rem;
			font-weight: 800;
			color: #0f172a;
			line-height: 1.2;
		}

		.car-meta {
			margin-top: 0.6rem;
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
			gap: 0.65rem;
			color: #475569;
			font-weight: 600;
			letter-spacing: 0.03em;
		}

		.car-meta span {
			background: #f8fafc;
			border: 1px solid #e2e8f0;
			border-radius: 0.9rem;
			padding: 0.55rem 0.75rem;
		}

		.car-description {
			margin-top: 1rem;
			background: #f8fafc;
			border: 1px solid #e2e8f0;
			border-radius: 1rem;
			padding: 1rem 1.1rem;
			color: #475569;
			line-height: 1.6;
		}
	</style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800">
	<%- include('../partials/navbar') %>
	<main class="mx-auto max-w-4xl px-4 py-10">
		<section class="mb-6">
			<a href="/" class="text-sm font-semibold text-blue-600 hover:text-blue-700">&larr; Back to cars</a>
		</section>
		<section class="rounded-2xl bg-white p-6 shadow">
			<h1 class="text-2xl font-bold">Car Details</h1>
			<p class="mt-1 text-sm text-slate-600">Here is the selected car card only.</p>

			<div class="mt-6 car-card">
				<% if (car.photoUrl) { %>
					<img src="<%= car.photoUrl %>" alt="<%= car.name %>" />
				<% } else { %>
					<div class="car-card-placeholder">
						<svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="1.4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8l2 5H6l2-5zM3 12h18v5a1 1 0 01-1 1H4a1 1 0 01-1-1v-5zm4 5v1m10-1v1" />
						</svg>
					</div>
				<% } %>
				<div class="car-card-body">
					<span class="car-badge">Car</span>
					<div class="car-name"><%= car.name %></div>
					<div class="car-meta">
						<span>Number: <%= car.cno %></span>
						<span>Rate: <%= car.carRate %>/hr</span>
					</div>
					<div class="car-description"><%= car.description || 'No description provided yet.' %></div>
					<form action="/book" method="POST" class="mt-6">
						<input type="hidden" name="carName" value="<%= car.name %>">
						<input type="hidden" name="carNo" value="<%= car.cno %>">
						<input type="hidden" name="carPhoto" value="<%= car.photoUrl %>">
						<input type="hidden" name="carRate" value="<%= car.carRate %>">
						<button type="submit" class="inline-flex w-full items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Book</button>
					</form>
				</div>
			</div>
		</section>
	</main>
</body>
</html>
