<nav style="background:#2563eb; display:flex; align-items:center; overflow:hidden; height:50px;">
  <button
    id="hamburger-menu"
    class="flex-shrink-0 flex items-center justify-center px-4 h-12 bg-transparent border-none text-white text-2xl cursor-pointer"
    aria-label="Open menu"
  >
    <i class="fa-solid fa-bars"></i>
  </button>

  <marquee
    behavior="scroll"
    direction="left"
    class="flex-1 text-sm font-medium text-white"
