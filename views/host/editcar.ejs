<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/output.css">
	<title>Car Details</title>
	<style>
		@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Syne:wght@700;800&display=swap');

		:root {
			color-scheme: light;
			--ink: #0f172a;
			--muted: #64748b;
			--line: #e2e8f0;
			--card: #ffffff;
			--wash: #f8fafc;
			--accent: #2563eb;
			--accent-deep: #1d4ed8;
			--accent-soft: #dbeafe;
		}

		body {
			font-family: 'DM Sans', sans-serif;
			background: radial-gradient(70% 60% at 10% 5%, #e0f2fe 0%, transparent 55%),
				linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
		}

		h1, h2 { font-family: 'Syne', sans-serif; }

		.page-shell {
			max-width: 1080px;
			margin: 0 auto;
			padding: 2.5rem 1rem 3.5rem;
		}

		.top-bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
		}

		.back-link {
			color: var(--accent);
			font-weight: 600;
			text-decoration: none;
		}

		.back-link:hover { color: var(--accent-deep); }

		.detail-card {
			margin-top: 1.5rem;
			background: var(--card);
			border-radius: 1.75rem;
			border: 1px solid rgba(148, 163, 184, 0.25);
			box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
			overflow: hidden;
		}

		.detail-grid {
			display: flex;
			flex-direction: column;
		}

		.media {
			position: relative;
			background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
			width: 100%;
			height: 340px;
		}

		@media (max-width: 640px) {
			.media { height: 220px; }
		}

		.media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.car-card-placeholder {
			width: 100%;
			height: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		/* ---------- Form panel ---------- */

		.info {
			padding: 2.4rem 2.4rem 2.6rem;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			background: var(--card);
		}

		.info form {
			width: 100%;
			max-width: 640px;
		}

		.form-header {
			display: flex;
			flex-direction:column;
			gap: 0.5rem;
		}

		.car-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			background: var(--accent-soft);
			color: var(--accent-deep);
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			padding: 4px 12px;
			border-radius: 999px;
			width:fit-content;
		}

		.form-title {
			font-family: 'Syne', sans-serif;
			font-size: 1.5rem;
			font-weight: 800;
			color: var(--ink);
		}

		.form-subtitle {
			color: var(--muted);
			font-size: 0.92rem;
		}

		/* Field groups replace one long stack with breathing room + logical clusters */

		.field-group {
			display: flex;
			flex-direction: column;
			gap: 1.1rem;
			padding: 1.4rem 1.4rem 1.5rem;
			background: var(--wash);
			border: 1px solid var(--line);
			border-radius: 1.1rem;
		}

		.group-label {
			font-size: 0.7rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--muted);
		}

		.field-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		@media (max-width: 480px) {
			.field-row { grid-template-columns: 1fr; }
		}

		.field {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}

		.field label {
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--ink);
		}

		.field .hint {
			font-size: 0.76rem;
			color: var(--muted);
			font-weight: 400;
		}

		.field input,
		.field textarea {
			width: 100%;
			background: #fff;
			border: 1px solid var(--line);
			border-radius: 0.7rem;
			padding: 0.65rem 0.85rem;
			font-size: 0.94rem;
			color: var(--ink);
			outline: none;
			transition: border-color 0.15s ease, box-shadow 0.15s ease;
		}

		.field input:focus,
		.field textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 0 3px var(--accent-soft);
		}

		.field textarea {
			resize: vertical;
			min-height: 110px;
			line-height: 1.55;
		}

		.rate-input-wrap {
			position: relative;
		}

		.rate-input-wrap input {
			padding-left: 2.1rem;
		}

		.rate-prefix {
			position: absolute;
			left: 0.85rem;
			top: 50%;
			transform: translateY(-50%);
			color: var(--muted);
			font-weight: 600;
			font-size: 0.9rem;
			pointer-events: none;
		}

		/* ---------- Actions ---------- */

		.actions {
			display: flex;
			gap: 0.75rem;
			padding-top: 0.25rem;
		}

		@media (max-width: 480px) {
			.actions { flex-direction: column; }
		}

		.primary-button {
			flex: 1;
			background: linear-gradient(135deg, var(--accent), #60a5fa);
			border: none;
			color: #fff;
			box-shadow: 0 12px 24px rgba(37, 99, 235, 0.28);
			transition: transform 0.2s ease, box-shadow 0.2s ease;
			cursor: pointer;
		}

		.primary-button:hover {
			transform: translateY(-1px);
			box-shadow: 0 18px 28px rgba(37, 99, 235, 0.32);
		}

		.ghost-button {
			flex: 1;
			background: #fff;
			border: 1px solid #bfdbfe;
			color: var(--accent-deep);
			box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);
			transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		}

		.ghost-button:hover {
			transform: translateY(-1px);
			border-color: #93c5fd;
			box-shadow: 0 12px 22px rgba(15, 23, 42, 0.12);
		}

		.actions a,
		.actions button {
			display: flex;
			align-items: center;
			justify-content: center;
		}
	</style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800">
	<%- include('../partials/navbar') %>
	<main class="page-shell">
		<section class="top-bar">
			<a href="/host/" class="back-link">&larr; Back to cars</a>
			<span class="text-sm text-slate-500">Car details</span>
		</section>
		<section class="detail-card">
			<div class="detail-grid">
				<div class="media">
					<% if (car.photoUrl) { %>
						<img src="<%= car.photoUrl %>" alt="<%= car.carName %>" />
					<% } else { %>
						<div class="car-card-placeholder">
							<svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="1.4">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8l2 5H6l2-5zM3 12h18v5a1 1 0 01-1 1H4a1 1 0 01-1-1v-5zm4 5v1m10-1v1" />
							</svg>
						</div>
					<% } %>
				</div>

				<div class="info">

					<form action="/host/editcar/<%= car._id %>" method="POST" class="flex-row">

						<div class="form-header">
							<span class="car-badge">Edit Car</span>
							<h2 class="form-title"><%= car.carName %></h2>
							<p class="form-subtitle">Update the listing details below, then save to publish your changes.</p>
						</div>

						<div class="field-group">
							<span class="group-label">Basics</span>
							<div class="field-row">
								<div class="field">
									<label for="carName">Car name</label>
									<input
									    class="w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
										id="carName"
										type="text"
										name="carName"
										value="<%= car.carName %>">
								</div>
								<div class="field">
									<label for="carNo">Car number</label>
									<input
									 class= "w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
										id="carNo"
										type="String"
										name="carNo"
										value="<%= car.carNo %>">
								</div>
							</div>
							<div class="field">
								<label for="carRate">Rate</label>
								<div class="rate-input-wrap">
									<span class="rate-prefix">₹</span>
									<input
									 class="w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
										id="carRate"
										type="number"
										name="carRate"
										value="<%= car.carRate %>">
								</div>
							</div>
						</div>

						<div class="field-group">
							<span class="group-label">Media</span>
							<div class="field">
								<label for="carPhoto">Photo URL</label>
								<span class="hint">Paste a direct link to an image of the car</span>
								<input
								 class="w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
									id="photoUrl"
									type="text"
									name="carPhoto"
									value="<%= car.photoUrl %>">
							</div>
						</div>

						<div class="field-group">
							<span class="group-label">Listing copy</span>
							<div class="field">
								<label for="carDescription">Description</label>
								<textarea
								   class="w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
									id="carDescription"
									name="carDescription"
									rows="5"><%= car.description %></textarea>
							</div>
						</div>

						<div class="actions">
							<button
								type="submit"
								class="primary-button rounded-xl py-3 font-semibold">
								💾 Save Changes
							</button>

							
								<a href="/host/manage-car"
								class="ghost-button rounded-xl py-3 font-semibold">
								Cancel
							</a>
						</div>

					</form>

				</div>
			</div>
		</section>
	</main>
</body>
</html>