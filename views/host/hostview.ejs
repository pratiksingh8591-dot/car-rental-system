<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/output.css">
	<title>Car Rental Home</title>
	<style>
		@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Syne:wght@700;800&display=swap');

		body { font-family: 'DM Sans', sans-serif; }
		h1, h2 { font-family: 'Syne', sans-serif; }

		.car-scroll {
			display: flex;
			gap: 1.25rem;
			overflow-x: auto;
			padding-bottom: 1rem;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
		}

		.car-scroll::-webkit-scrollbar {
			height: 6px;
		}
		.car-scroll::-webkit-scrollbar-track {
			background: #e2e8f0;
			border-radius: 99px;
		}
		.car-scroll::-webkit-scrollbar-thumb {
			background: #94a3b8;
			border-radius: 99px;
		}

		.car-card {
			position: relative;
			flex: 0 0 260px;
			scroll-snap-align: start;
			background: #fff;
			border-radius: 1.25rem;
			overflow: hidden;
			box-shadow: 0 2px 12px rgba(0,0,0,0.07);
			transition: transform 0.25s ease, box-shadow 0.25s ease;
		}
		.car-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 8px 28px rgba(0,0,0,0.13);
		}

		.car-card img {
			width: 100%;
			height: 160px;
			object-fit: cover;
			display: block;
		}

		.car-card-placeholder {
			width: 100%;
			height: 160px;
			background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.car-card-body {
			padding: 1rem 1.1rem 1.2rem;
		}

		.car-badge {
			display: inline-block;
			background: #eff6ff;
			color: #2563eb;
			font-size: 0.72rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
			padding: 3px 10px;
			border-radius: 99px;
			margin-bottom: 0.5rem;
		}

		.car-name {
			font-family: 'Syne', sans-serif;
			font-size: 1.05rem;
			font-weight: 700;
			color: #0f172a;
			line-height: 1.3;
		}

		.car-number {
			margin-top: 0.25rem;
			font-size: 0.875rem;
			color: #64748b;
			font-weight: 500;
			letter-spacing: 0.04em;
		}

		.car-desc {
			margin-top: 0.5rem;
			font-size: 0.85rem;
			color: #475569;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		.empty-state {
			flex: 0 0 100%;
			border: 2px dashed #cbd5e1;
			border-radius: 1.25rem;
			padding: 2.5rem;
			text-align: center;
			color: #94a3b8;
			font-size: 0.95rem;
		}
	</style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800">
	<%- include('../partials/navbar') %>
	<main class="mx-auto max-w-6xl px-4 py-10 space-y-8">

		<!-- Hero Section -->
		<section class="rounded-2xl bg-white p-6 shadow">
			<h1 class="text-3xl font-bold tracking-tight">Welcome to Car Rental</h1>
			<p class="mt-2 text-slate-600">Manage your cars and bookings in one place.</p>
			<div class="mt-5 flex flex-wrap gap-3">
				<a href="/host/manage-car" class="inline-block rounded-lg border border-slate-300 bg-white px-5 py-2.5 font-medium text-slate-700 transition hover:bg-slate-50">Manage car</a>
			</div>
		</section>

		<!-- Car List Section -->
		<section>
			<div class="flex items-center justify-between mb-5">
				<h2 class="text-2xl font-bold text-slate-900">Registered Cars</h2>
				<% if (lcar.length > 0) { %>
					<!-- <span class="text-sm text-slate-500"><%= lcar.length %> car<%= lcar.length > 1 ? 's' : '' %></span> -->
				<% } %>
			</div>

			<div class="car-scroll mt-4">
				<% if (lcar.length === 0) { %>
					<div class="empty-state">No cars added yet.</div>
				<% } else { %>
					<% lcar.forEach((car) => { %>
						<div class="car-card">
							<% if (car.photoUrl) { %>
								<img src="<%= car.photoUrl %>" alt="<%= car.name %>" />
							<% } else { %>
								<div class="car-card-placeholder">
									<svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="1.4">
										<path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8l2 5H6l2-5zM3 12h18v5a1 1 0 01-1 1H4a1 1 0 01-1-1v-5zm4 5v1m10-1v1" />
									</svg>
								</div>
							<% } %>
							<div class="car-card-body">
								<span class="car-badge">Car</span>
								<div class="car-name"><%= car.name %></div>
								<div class="car-number"><%= car.cno %></div>
								<div class="car-number"><%= car.carRate %>/hr</div>
								
								<a class="mt-4" href="/car/<%= car.id %>">details</a>
								
                                	<form action="/host/editcar/<%= car.id %>" method="GET" class="mt-4">
									<button type="submit" class="inline-flex w-full items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">edit</button>
								</form>

							</div>

						</div>
					<% }) %>
				<% } %>
			</div>
		</section>

	</main>
</body>
</html>